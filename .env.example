# --- required ---
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/qaryati_db?schema=public"
JWT_ACCESS_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# --- optional ---
NODE_ENV=development
PORT=3000
# Comma-separated list of browser origins allowed by CORS (empty = no cross-origin access)
CORS_ORIGINS=
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Seed accounts are created only if both values of a pair are set (npm run db:seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_VERIFIER_EMAIL=
SEED_VERIFIER_PASSWORD=

# External geocoding provider (adapter in src/adapters/geocoding.adapter.js)
GEOCODING_API_URL=
GEOCODING_API_KEY=
